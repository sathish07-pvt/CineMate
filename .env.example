# ==========================================
# CineMate Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Prisma)
# For local zero-config development (SQLite):
DATABASE_URL="file:./dev.db"

# For PostgreSQL production / staging:
# DATABASE_URL="postgresql://cinemate_user:cinemate_password@localhost:5432/cinemate?schema=public"

# Authentication & Security
JWT_SECRET=cinemate_jwt_secure_secret_token_key_change_in_production
JWT_EXPIRES_IN=7d

# Movie Metadata & OTT Provider API (TMDB)
# Obtain a free API key at https://www.themoviedb.org/settings/api
# If left empty, CineMate seamlessly runs with its comprehensive built-in catalog
TMDB_API_KEY=
